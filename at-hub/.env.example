# AT-HUB configuration
DATABASE_URL=sqlite:///./at_hub.db
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS: comma-separated origins allowed to call this API
CORS_ORIGINS=["http://localhost:8010","http://127.0.0.1:8010"]

# Seeded on first startup if no users exist yet
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Outgoing email for "Send invoice by email". Leave SMTP_HOST empty to disable.
# Gmail / Google Workspace: smtp.gmail.com, port 587, and an App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls

# Private AI (PDF purchase order -> draft customer order). Uses a local Ollama server, so
# documents stay on this machine. Install Ollama, then: ollama pull qwen2.5:7b
# Only localhost / private-network URLs are accepted.
AI_OLLAMA_URL=http://127.0.0.1:11434
AI_MODEL=qwen2.5:7b
# Reads photos and scanned PDFs (PODs, scanned invoices): ollama pull qwen2.5vl:7b
AI_VISION_MODEL=qwen2.5vl:7b

# Keep TEST-* products, a test customer/vendor and an open test order ready at every startup (dev only)
TEST_DATA_ENABLED=false
