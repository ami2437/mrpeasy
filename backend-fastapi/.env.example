# MRPeasy API Configuration
MRPEASY_API_BASE_URL=https://api.mrpeasy.com/rest/v1
MRPEASY_API_KEY=your_api_key_here
MRPEASY_API_SECRET=your_api_secret_here

# Database Configuration
DATABASE_URL=sqlite:///./mrpeasy.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/mrpeasy

# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
